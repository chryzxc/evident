{
  "name": "@evident/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@evident/adapters": "workspace:*",
    "@evident/cache": "workspace:*",
    "@evident/config": "workspace:*",
    "@evident/controls": "workspace:*",
    "@evident/deduplicator": "workspace:*",
    "@evident/evidence": "workspace:*",
    "@evident/normalizer": "workspace:*",
    "@evident/regression": "workspace:*",
    "@evident/reporters": "workspace:*",
    "@evident/repository": "workspace:*",
    "@evident/rules": "workspace:*",
    "@evident/rules": "workspace:*",
    "@evident/types": "workspace:*",
    "p-limit": "^6.1.0"
  }
}
