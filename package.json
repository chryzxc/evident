{
  "name": "evident",
  "version": "0.1.0",
  "private": true,
  "description": "Repository security scanner orchestrator: run Semgrep, Trivy, TruffleHog and npm audit, deduplicate findings, map SOC 2 technical evidence, and report as SARIF, JSON and HTML.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "turbo": "^2.0.14",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  },
  "license": "MIT",
  "author": "Christian Rey Villablanca",
  "homepage": "https://github.com/chryzxc/evident#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chryzxc/evident.git"
  },
  "bugs": {
    "url": "https://github.com/chryzxc/evident/issues"
  },
  "keywords": [
    "security-scanner",
    "security",
    "devsecops",
    "appsec",
    "sast",
    "sca",
    "secret-scanning",
    "semgrep",
    "trivy",
    "trufflehog",
    "npm-audit",
    "sarif",
    "github-actions",
    "ci",
    "soc2",
    "compliance-evidence",
    "vulnerability-management",
    "deduplication",
    "typescript",
    "nodejs",
    "cli"
  ]
}
